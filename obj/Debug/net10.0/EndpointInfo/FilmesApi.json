{
  "openapi": "3.1.1",
  "info": {
    "title": "FilmesApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7245"
    },
    {
      "url": "http://localhost:5233"
    }
  ],
  "paths": {
    "/FilmesControllers": {
      "post": {
        "tags": [
          "FilmesControllers"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Filme"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Filme"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Filme"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Filme": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "genero": {
            "type": "string"
          },
          "duracao": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "FilmesControllers"
    }
  ]
}